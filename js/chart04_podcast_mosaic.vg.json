{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chapter 2 - mosaic (Marimekko) chart, one panel per audience. Splits 100 people into listened only, watched only, both and neither for podcasts (Infinite Dial 2026). Column width = listened or not; box height = watched or not, so box area = share of people.",
  "data": {
    "description": "Load the merged CSV (data/australian_radio_data.csv), which holds every dataset used on the page.",
    "url": "data/australian_radio_data.csv",
    "format": {
      "type": "csv",
      "parse": {"value": "number"}
    }
  },
  "transform": [
    {
      "description": "Keep the monthly podcast rows and label the two audiences.",
      "filter": "datum.dataset == 'Audience survey'"
    },
    {"filter": "datum.metric == 'Monthly podcast consumption 2026'"},
    {
      "calculate": "datum.geography == 'Australia' ? 'Australia overall' : 'Regional Australia'",
      "as": "audience"
    },
    {
      "description": "Pivot, then derive the four exclusive groups from Listened, Watched and 'Listened or watched'.",
      "pivot": "subgroup",
      "value": "value",
      "groupby": ["audience"]
    },
    {
      "calculate": "datum['Listened'] + datum['Watched'] - datum['Listened or watched']",
      "as": "Both"
    },
    {"calculate": "datum['Listened'] - datum['Both']", "as": "Listened only"},
    {"calculate": "datum['Watched'] - datum['Both']", "as": "Watched only"},
    {"calculate": "100 - datum['Listened or watched']", "as": "Neither"},
    {"calculate": "datum['Listened']", "as": "listen_total"},
    {"calculate": "100 * datum['Both'] / datum.listen_total", "as": "both_split"},
    {
      "calculate": "100 * datum['Watched only'] / (100 - datum.listen_total)",
      "as": "watch_split"
    },
    {
      "description": "Fold the four groups into rows and compute each box's corners (x0-x1, y0-y1) and centre.",
      "fold": ["Both", "Listened only", "Watched only", "Neither"],
      "as": ["combination", "share_pct"]
    },
    {
      "calculate": "datum.combination == 'Both' || datum.combination == 'Listened only' ? 0 : datum.listen_total",
      "as": "x0"
    },
    {
      "calculate": "datum.combination == 'Both' || datum.combination == 'Listened only' ? datum.listen_total : 100",
      "as": "x1"
    },
    {
      "calculate": "datum.combination == 'Listened only' ? datum.both_split : datum.combination == 'Neither' ? datum.watch_split : 0",
      "as": "y0"
    },
    {
      "calculate": "datum.combination == 'Both' ? datum.both_split : datum.combination == 'Watched only' ? datum.watch_split : 100",
      "as": "y1"
    },
    {"calculate": "(datum.x0+datum.x1)/2", "as": "xc"},
    {"calculate": "(datum.y0+datum.y1)/2", "as": "yc"},
    {"calculate": "format(datum.share_pct,'.0f')+'%'", "as": "pct_label"}
  ],
  "facet": {
    "column": {
      "field": "audience",
      "type": "nominal",
      "sort": ["Australia overall", "Regional Australia"],
      "title": null,
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 8,
        "labelExpr": "datum.label == 'Australia overall' ? 'Australia overall · 35% both' : 'Regional Australia · 28% both'"
      }
    }
  },
  "spec": {
    "description": "Facet: one panel for Australia overall and one for regional Australia (sized in main.js).",
    "width": 255,
    "height": 255,
    "layer": [
      {
        "description": "The four boxes; violet shades = podcast groups.",
        "mark": {"type": "rect", "stroke": "#FFFFFF", "strokeWidth": 2},
        "encoding": {
          "x": {
            "field": "x0",
            "type": "quantitative",
            "scale": {"domain": [0, 100]},
            "axis": null
          },
          "x2": {"field": "x1"},
          "y": {
            "field": "y0",
            "type": "quantitative",
            "scale": {"domain": [0, 100], "reverse": true},
            "axis": null
          },
          "y2": {"field": "y1"},
          "color": {
            "field": "combination",
            "type": "nominal",
            "title": "Podcast behaviour",
            "scale": {
              "domain": ["Both", "Listened only", "Watched only", "Neither"],
              "range": ["#6C5BB5", "#A194D6", "#D6D0F0", "#D8E0E6"]
            },
            "legend": {"orient": "bottom", "columns": 2}
          },
          "tooltip": [
            {"field": "audience", "title": "Population"},
            {"field": "combination", "title": "Behaviour"},
            {
              "field": "share_pct",
              "type": "quantitative",
              "title": "Share (%)",
              "format": ".0f"
            }
          ]
        }
      },
      {
        "description": "Percentage label in the middle of each box.",
        "mark": {"type": "text", "fontWeight": "bold", "fontSize": 16},
        "encoding": {
          "x": {
            "field": "xc",
            "type": "quantitative",
            "scale": {"domain": [0, 100]},
            "axis": null
          },
          "y": {
            "field": "yc",
            "type": "quantitative",
            "scale": {"domain": [0, 100], "reverse": true},
            "axis": null
          },
          "text": {"field": "pct_label"},
          "color": {
            "condition": {"test": "datum.combination == 'Both'", "value": "#FFFFFF"},
            "value": "#14212D"
          }
        }
      },
      {
        "description": "Annotation under each column: the column width is the share who listened (left) or did not (right).",
        "transform": [
          {"filter": "datum.combination == 'Both' || datum.combination == 'Neither'"},
          {
            "calculate": "datum.combination == 'Both' ? ['Listened', format(datum.listen_total, '.0f') + '%'] : ['Did not listen', format(100 - datum.listen_total, '.0f') + '%']",
            "as": "column_label"
          },
          {"calculate": "(datum.x0 + datum.x1) / 2", "as": "column_middle"}
        ],
        "mark": {
          "type": "text",
          "baseline": "top",
          "dy": 6,
          "fontSize": 13,
          "color": "#3E5263",
          "lineHeight": 15
        },
        "encoding": {
          "x": {
            "field": "column_middle",
            "type": "quantitative",
            "scale": {"domain": [0, 100]},
            "axis": null
          },
          "y": {
            "datum": 100,
            "type": "quantitative",
            "scale": {"domain": [0, 100], "reverse": true},
            "axis": null
          },
          "text": {"field": "column_label"}
        }
      }
    ]
  },
  "resolve": {
    "scale": {"x": "independent", "y": "independent"}
  },
  "config": {
    "view": {"stroke": null},
    "facet": {"spacing": 22}
  }
}
