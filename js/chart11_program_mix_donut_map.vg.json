{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Chapter 4 - donut-glyph map (Vega, linked to the city buttons). Each donut splits one capital city's radio listening by program type in the GfK survey chosen with the slider (Surveys 3-6). Donuts sit offshore with a leader line to the city; the selected city gets a dark ring, and clicking a donut selects that city in all four linked charts.",
  "padding": 10,
  "autosize": "none",
  "signals": [
    {
      "description": "Chart width follows its card (updates on window resize).",
      "name": "width",
      "init": "containerSize()[0] > 100 ? containerSize()[0] - 20 : 540",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 100 ? containerSize()[0] - 20 : 540"
        }
      ]
    },
    {
      "description": "Phone layout: the map fills the width and the donuts sit in a grid under it, instead of offshore beside their cities.",
      "name": "narrow",
      "update": "width < 420"
    },
    {
      "description": "Chart height: taller on phones to fit the donut grid under the map.",
      "name": "height",
      "update": "narrow ? 580 : 395"
    },
    {
      "description": "Selected city; main.js sets it when a city button is clicked.",
      "name": "SelectedMarket",
      "value": "Melbourne"
    },
    {
      "description": "Time slider: which GfK survey the donuts show (3 to 6).",
      "name": "Survey_pick",
      "value": 6,
      "bind": {"input": "range", "min": 3, "max": 6, "step": 1, "name": "Survey shown: "}
    }
  ],
  "projections": [
    {
      "description": "Mercator projection fitted to Australia.",
      "name": "projection",
      "type": "mercator",
      "fit": {"signal": "data('states')"},
      "extent": {"signal": "narrow ? [[20, 10], [width - 20, 220]] : [[45, 0], [width - 130, height - 100]]"}
    }
  ],
  "data": [
    {
      "description": "Australian state boundaries (TopoJSON, cartdeco/Australia-json-data).",
      "name": "states",
      "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
      "format": {"type": "topojson", "feature": "collection"}
    },
    {
      "description": "Load the merged CSV (data/australian_radio_data.csv), which holds every dataset used on the page. Keep the station ratings for the survey chosen with the slider.",
      "name": "stations",
      "url": "data/australian_radio_data.csv",
      "format": {
        "type": "csv",
        "parse": {
          "survey": "number",
          "share": "number",
          "latitude": "number",
          "longitude": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.dataset == 'Station ratings' && datum.survey == Survey_pick"
        }
      ]
    },
    {
      "description": "Add up rated stations' shares by city and program type.",
      "name": "rated",
      "source": "stations",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["market", "program_format", "latitude", "longitude"],
          "fields": ["share"],
          "ops": ["sum"],
          "as": ["type_share"]
        }
      ]
    },
    {
      "description": "The rest of each city's listening ('Other / unrated stations').",
      "name": "other",
      "source": "stations",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["market", "latitude", "longitude"],
          "fields": ["share"],
          "ops": ["sum"],
          "as": ["rated_total"]
        },
        {"type": "formula", "as": "program_format", "expr": "'Other / unrated stations'"},
        {"type": "formula", "as": "type_share", "expr": "100 - datum.rated_total"}
      ]
    },
    {
      "description": "All donut slices in a fixed order, with each city's map point and offshore donut position.",
      "name": "slices",
      "source": ["rated", "other"],
      "transform": [
        {
          "type": "formula",
          "as": "type_share",
          "expr": "round(datum.type_share * 10) / 10"
        },
        {
          "type": "formula",
          "as": "format_order",
          "expr": "indexof(['Commercial music', 'ABC music', 'Commercial talk & news', 'ABC talk & news', 'Sport', 'Other / unrated stations'], datum.program_format)"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["longitude", "latitude"],
          "as": ["px", "py"]
        },
        {
          "type": "formula",
          "as": "grid_index",
          "expr": "indexof(['Perth', 'Adelaide', 'Melbourne', 'Sydney', 'Brisbane'], datum.market)"
        },
        {
          "type": "formula",
          "as": "cx",
          "expr": "narrow ? (datum.grid_index == 4 ? width / 2 : datum.grid_index % 2 == 0 ? width * 0.25 : width * 0.75) : datum.px + (datum.market == 'Sydney' ? 88 : datum.market == 'Brisbane' ? 83 : datum.market == 'Adelaide' ? -62 : 0)"
        },
        {
          "type": "formula",
          "as": "cy",
          "expr": "narrow ? 277 + floor(datum.grid_index / 2) * 112 : datum.py + (datum.market == 'Sydney' ? 28 : datum.market == 'Brisbane' ? -34 : datum.market == 'Adelaide' ? 72 : datum.market == 'Melbourne' ? 80 : 0)"
        }
      ]
    },
    {
      "description": "One row per city: music and talk totals for the label, plus positions.",
      "name": "cities",
      "source": "slices",
      "transform": [
        {
          "type": "formula",
          "as": "music",
          "expr": "indexof(datum.program_format, 'music') >= 0 ? datum.type_share : 0"
        },
        {
          "type": "formula",
          "as": "talk",
          "expr": "indexof(datum.program_format, 'talk') >= 0 ? datum.type_share : 0"
        },
        {
          "type": "aggregate",
          "groupby": ["market", "px", "py", "cx", "cy"],
          "fields": ["music", "talk"],
          "ops": ["sum", "sum"],
          "as": ["music", "talk"]
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "[datum.market, 'Music ' + round(datum.music) + '% · Talk ' + round(datum.talk) + '%']"
        }
      ]
    }
  ],
  "scales": [
    {
      "description": "Program-type colours, shared with Charts 10, 12 and 13 (legend in the survey strip above Charts 11-12).",
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Commercial music",
        "ABC music",
        "Commercial talk & news",
        "ABC talk & news",
        "Sport",
        "Other / unrated stations"
      ],
      "range": ["#B5446E", "#E8A6C0", "#94701A", "#78B84A", "#00B5C9", "#A69C8D"]
    }
  ],
  "marks": [
    {
      "description": "State outlines (base map).",
      "type": "shape",
      "from": {"data": "states"},
      "encode": {
        "enter": {
          "fill": {"value": "#EEF1F3"},
          "stroke": {"value": "#C5D0D8"},
          "strokeWidth": {"value": 0.6}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    },
    {
      "type": "rule",
      "description": "leader line from the city to its donut (not on phones, where the donuts sit in a grid)",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"field": "px"},
          "y": {"field": "py"},
          "x2": {"field": "cx"},
          "y2": {"field": "cy"},
          "stroke": {"value": "#7A8992"},
          "strokeWidth": {"value": 1},
          "strokeOpacity": {"signal": "narrow ? 0 : 1"}
        }
      }
    },
    {
      "type": "symbol",
      "description": "the city's real location",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"field": "px"},
          "y": {"field": "py"},
          "size": {"value": 30},
          "fill": {"value": "#132D43"}
        }
      }
    },
    {
      "type": "text",
      "description": "Phones only: city name beside its dot, since there are no leader lines to the donut grid.",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"field": "px"},
          "y": {"field": "py"},
          "dx": {"signal": "datum.market == 'Adelaide' ? -7 : datum.market == 'Melbourne' ? 0 : 7"},
          "dy": {"signal": "datum.market == 'Melbourne' ? 12 : 0"},
          "align": {"signal": "datum.market == 'Adelaide' ? 'right' : datum.market == 'Melbourne' ? 'center' : 'left'"},
          "baseline": {"signal": "datum.market == 'Melbourne' ? 'top' : 'middle'"},
          "text": {"signal": "narrow ? datum.market : ''"},
          "fontSize": {"value": 12},
          "fontWeight": {"signal": "datum.market == SelectedMarket ? 'bold' : 'normal'"},
          "fill": {"value": "#1F3545"}
        }
      }
    },
    {
      "type": "symbol",
      "description": "dark ring around the selected city",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"field": "cx"},
          "y": {"field": "cy"},
          "size": {"signal": "narrow ? 3600 : 5184"},
          "fill": {"value": "transparent"},
          "stroke": {"value": "#132D43"},
          "strokeWidth": {"signal": "datum.market == SelectedMarket ? 3 : 0"}
        }
      }
    },
    {
      "type": "group",
      "description": "one donut for each city",
      "from": {
        "facet": {
          "data": "slices",
          "name": "city_slices",
          "groupby": ["market", "cx", "cy"]
        }
      },
      "encode": {
        "update": {
          "x": {"field": "cx"},
          "y": {"field": "cy"}
        }
      },
      "data": [
        {
          "name": "city_pie",
          "source": "city_slices",
          "transform": [
            {
              "type": "collect",
              "sort": {"field": "format_order"}
            },
            {"type": "pie", "field": "type_share"}
          ]
        }
      ],
      "marks": [
        {
          "type": "arc",
          "from": {"data": "city_pie"},
          "encode": {
            "enter": {
              "stroke": {"value": "#FFFFFF"},
              "strokeWidth": {"value": 1},
              "cursor": {"value": "pointer"}
            },
            "update": {
              "innerRadius": {"signal": "narrow ? 13 : 16"},
              "outerRadius": {"signal": "narrow ? 27 : 33"},
              "startAngle": {"field": "startAngle"},
              "endAngle": {"field": "endAngle"},
              "fill": {"scale": "color", "field": "program_format"},
              "tooltip": {
                "signal": "{'City': datum.market, 'Program type': datum.program_format, 'Share of listening (%)': datum.type_share}"
              }
            }
          },
          "description": "Donut slices; angles and colours are in 'update' so they redraw when the slider moves."
        }
      ]
    },
    {
      "type": "text",
      "description": "Annotation in the empty space above the Brisbane donut, on the same line as the treemap's first group label beside it (y 37 = the treemap's 22px top padding + 15, alphabetic baseline, same chart padding). On phones it sits just above the donut grid.",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"signal": "narrow ? width / 2 : datum.cx"},
          "y": {"signal": "narrow ? 242 : 37"},
          "align": {"value": "center"},
          "baseline": {"signal": "narrow ? 'bottom' : 'alphabetic'"},
          "text": {"signal": "datum.market == 'Brisbane' ? 'Click a donut to select a city ↓' : ''"},
          "fontSize": {"value": 13},
          "fontStyle": {"value": "italic"},
          "fill": {"value": "#5C7182"}
        }
      }
    },
    {
      "type": "text",
      "description": "city name, music share and talk share",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"field": "cx"},
          "y": {"signal": "datum.cy + (narrow ? 32 : 38)"},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "text": {"field": "label"},
          "fontSize": {"value": 13},
          "fontWeight": {"signal": "datum.market == SelectedMarket ? 'bold' : 'normal'"},
          "lineHeight": {"value": 16},
          "fill": {"value": "#1F3545"}
        }
      }
    }
  ]
}
