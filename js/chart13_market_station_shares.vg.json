{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/metro_station_share_2026.csv",
    "format": {
      "type": "csv",
      "parse": {"survey": "number", "share": "number", "rank": "number"}
    }
  },
  "params": [
    {"name": "SelectedMarket", "value": "Melbourne"}
  ],
  "transform": [
    {"filter": "datum.market == SelectedMarket"},
    {
      "pivot": "survey",
      "value": "share",
      "groupby": ["market", "station", "program_format"]
    },
    {"calculate": "datum['5']", "as": "share_now"},
    {"calculate": "datum['4']", "as": "share_before"},
    {
      "calculate": "round((datum.share_now - datum.share_before) * 10) / 10",
      "as": "change"
    },
    {
      "calculate": "datum.change > 0 ? '▲ ' + datum.change : datum.change < 0 ? '▼ ' + abs(datum.change) : '–'",
      "as": "change_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "station",
      "type": "nominal",
      "title": null,
      "sort": {"field": "share_now", "order": "descending"},
      "axis": {"labelFontSize": 13, "labelLimit": 140}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {"band": 0.72},
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "share_now",
          "type": "quantitative",
          "title": "Share of radio listening, Survey 5 (%)",
          "scale": {"domain": [0, 20]}
        },
        "color": {
          "field": "program_format",
          "type": "nominal",
          "title": "Program type",
          "scale": {
            "domain": [
              "Commercial music",
              "ABC music",
              "Commercial talk & news",
              "ABC talk & news",
              "Sport"
            ],
            "range": ["#E47B5C", "#F2B8A0", "#2F5D8A", "#7FA3C7", "#E2B33C"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "station", "title": "Station"},
          {"field": "program_format", "title": "Program type"},
          {"field": "3", "type": "quantitative", "title": "Survey 3 share (%)"},
          {"field": "4", "type": "quantitative", "title": "Survey 4 share (%)"},
          {"field": "5", "type": "quantitative", "title": "Survey 5 share (%)"}
        ]
      }
    },
    {
      "mark": {"type": "tick", "color": "#132D43", "thickness": 2.5, "bandSize": 18},
      "encoding": {
        "x": {"field": "share_before", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 13},
      "encoding": {
        "x": {"field": "share_now", "type": "quantitative"},
        "text": {"field": "change_label"},
        "color": {
          "condition": [
            {"test": "datum.change > 0", "value": "#1B7F4B"},
            {"test": "datum.change < 0", "value": "#C2413A"}
          ],
          "value": "#7A8992"
        }
      }
    }
  ]
}
