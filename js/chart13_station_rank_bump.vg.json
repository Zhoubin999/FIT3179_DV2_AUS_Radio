{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chapter 4 - bump chart (linked to the city buttons). Rank of the top five stations in the selected city across Surveys 3-6 (GfK ratings). Shared encoding: x = survey, y = rank (1 at the top), colour = program type, one line per station.",
  "width": "container",
  "height": 320,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "padding": {"left": 5, "top": 5, "bottom": 5, "right": 80},
  "data": {
    "description": "Load the merged CSV (data/australian_radio_data.csv), which holds every dataset used on the page.",
    "url": "data/australian_radio_data.csv",
    "format": {
      "type": "csv",
      "parse": {
        "survey": "number",
        "share": "number",
        "rank": "number",
        "latest_rank": "number"
      }
    }
  },
  "params": [
    {
      "description": "Selected city; main.js sets it when a city button is clicked.",
      "name": "SelectedMarket",
      "value": "Melbourne"
    }
  ],
  "transform": [
    {
      "description": "Keep the selected city's stations that are in the top five in Survey 6.",
      "filter": "datum.dataset == 'Station ratings'"
    },
    {"filter": "datum.market == SelectedMarket"},
    {"filter": "datum.latest_rank <= 5"},
    {"calculate": "'Survey ' + datum.survey", "as": "survey_name"}
  ],
  "encoding": {
    "x": {
      "field": "survey",
      "type": "ordinal",
      "title": null,
      "scale": {"padding": 0.3},
      "axis": {
        "labelExpr": "'Survey ' + datum.label",
        "labelAngle": 0,
        "labelFontSize": 14,
        "orient": "top"
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank in the city (1 = most listened)",
      "scale": {"domain": [6.4, 0.6]},
      "axis": {"values": [1, 2, 3, 4, 5, 6], "grid": true}
    },
    "color": {
      "field": "program_format",
      "type": "nominal",
      "scale": {
        "domain": [
          "Commercial music",
          "ABC music",
          "Commercial talk & news",
          "ABC talk & news",
          "Sport"
        ],
        "range": ["#B5446E", "#E8A6C0", "#B0821F", "#DDB453", "#7A6552"]
      },
      "legend": null
    },
    "detail": {"field": "station", "type": "nominal"}
  },
  "layer": [
    {
      "description": "Rank lines with a point for each survey.",
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "point": {"filled": true, "size": 160}
      },
      "encoding": {
        "tooltip": [
          {"field": "station", "title": "Station"},
          {"field": "survey_name", "title": "Survey"},
          {"field": "rank", "title": "Rank"},
          {"field": "share", "title": "Share (%)"},
          {"field": "program_format", "title": "Program type"}
        ]
      }
    },
    {
      "description": "Station name and share at the right end; tied ranks are stacked so labels do not overlap.",
      "transform": [
        {"filter": "datum.survey == 6"},
        {"calculate": "datum.station + ' (' + datum.share + '%)'", "as": "end_label"},
        {
          "window": [
            {"op": "row_number", "as": "tie_order"}
          ],
          "groupby": ["rank"],
          "sort": [
            {"field": "station"}
          ]
        },
        {"calculate": "datum.rank + (datum.tie_order - 1) * 0.4", "as": "label_y"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {"field": "end_label"},
        "y": {"field": "label_y", "type": "quantitative"},
        "color": {"value": "#1F3545"}
      }
    },
    {
      "description": "Survey 3 share at the left end of each line.",
      "transform": [
        {"filter": "datum.survey == 3"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -14, "fontSize": 12},
      "encoding": {
        "text": {"field": "share", "type": "quantitative", "format": ".1f"},
        "color": {"value": "#5C7182"}
      }
    }
  ]
}
