{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chapter 2 - dumbbell chart. Weekly radio reach by age group, Australia overall vs regional Australia (Infinite Dial 2026). Shared encoding: y = age group, x = reach (%).",
  "width": "container",
  "height": 315,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "data": {
    "description": "Load the merged CSV (data/australian_radio_data.csv), which holds every dataset used on the page.",
    "url": "data/australian_radio_data.csv",
    "format": {
      "type": "csv",
      "parse": {"value": "number"}
    }
  },
  "transform": [
    {
      "description": "Keep radio weekly reach by age group and label the two audiences.",
      "filter": "datum.dataset == 'Audience survey'"
    },
    {
      "filter": "datum.metric == 'Total radio weekly reach' && datum.subgroup_type == 'Age group'"
    },
    {
      "calculate": "datum.geography == 'Australia' ? 'Australia overall' : 'Regional Australia'",
      "as": "audience"
    },
    {
      "calculate": "datum.subgroup == 'Total' ? 'All ages' : datum.subgroup",
      "as": "age_group"
    },
    {"calculate": "datum.value", "as": "share_pct"},
    {
      "description": "Pivot so each age group is one row with both audiences, then compute the gap.",
      "pivot": "audience",
      "value": "share_pct",
      "groupby": ["age_group"],
      "op": "max"
    },
    {"calculate": "datum['Australia overall'] - datum['Regional Australia']", "as": "gap"},
    {
      "calculate": "datum.gap == 0 ? 'Same reach: 80%' : (format(datum.gap,'.0f') + ' percentage-point gap')",
      "as": "gap_label"
    },
    {"calculate": "'Gap: ' + format(datum.gap, '.0f') + ' points'", "as": "gap_note"}
  ],
  "encoding": {
    "x": {
      "field": "Australia overall",
      "type": "quantitative",
      "scale": {"domain": [45, 85], "nice": false},
      "axis": {
        "title": "Weekly radio reach (%)",
        "values": [50, 60, 70, 80],
        "grid": true
      }
    },
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": "Age",
      "sort": ["10–24", "25–54", "55+", "All ages"],
      "axis": {"labelFontSize": 14}
    }
  },
  "layer": [
    {
      "description": "Grey bar joining the two values (the size of the gap).",
      "mark": {
        "type": "rule",
        "stroke": "#A7B9C5",
        "strokeWidth": 4,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {"field": "Regional Australia", "type": "quantitative"},
        "x2": {"field": "Australia overall"},
        "tooltip": [
          {"field": "age_group", "title": "Age"},
          {"field": "Australia overall", "title": "Australia overall (%)"},
          {"field": "Regional Australia", "title": "Regional Australia (%)"},
          {"field": "gap", "title": "Gap (percentage points)"}
        ]
      }
    },
    {
      "description": "Dot for Australia overall (dark grey).",
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 175,
        "color": "#44515C",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "Australia overall", "type": "quantitative"}
      }
    },
    {
      "description": "Dot for regional Australia (teal).",
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 175,
        "color": "#14857A",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "Regional Australia", "type": "quantitative"}
      }
    },
    {
      "description": "Australia overall value, to the right of its dot.",
      "transform": [
        {"filter": "datum.age_group != '55+'"}
      ],
      "mark": {
        "type": "text",
        "dx": 12,
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#44515C"
      },
      "encoding": {
        "x": {"field": "Australia overall", "type": "quantitative"},
        "text": {"field": "Australia overall", "type": "quantitative", "format": ".0f"}
      }
    },
    {
      "description": "Regional value, to the left of its dot.",
      "transform": [
        {"filter": "datum.age_group != '55+'"}
      ],
      "mark": {
        "type": "text",
        "dx": -12,
        "align": "right",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#14857A"
      },
      "encoding": {
        "x": {"field": "Regional Australia", "type": "quantitative"},
        "text": {"field": "Regional Australia", "type": "quantitative", "format": ".0f"}
      }
    },
    {
      "description": "For 55+ both values are equal, so one 'Same reach' label replaces the two numbers.",
      "transform": [
        {"filter": "datum.age_group == '55+'"}
      ],
      "mark": {
        "type": "text",
        "dx": -14,
        "dy": -14,
        "align": "right",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#243D50"
      },
      "encoding": {
        "x": {"field": "Australia overall", "type": "quantitative"},
        "text": {"field": "gap_label", "type": "nominal"}
      }
    },
    {
      "description": "Size of the gap written at the left edge of each row (empty space before the dots).",
      "transform": [
        {"filter": "datum.age_group != '55+'"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#5C7182"
      },
      "encoding": {
        "x": {"datum": 45},
        "text": {"field": "gap_note"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
