{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 470,
  "params": [
    {"name": "SelectedMarket", "value": "Melbourne"}
  ],
  "projection": {"type": "mercator", "center": [134, -29]},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
        "format": {"type": "topojson", "feature": "collection"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF1F3",
        "stroke": "#C5D0D8",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/metro_station_share_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "survey": "number",
            "share": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.survey == 5"},
        {
          "window": [
            {"op": "row_number", "as": "position"},
            {"op": "lead", "field": "share", "as": "runner_up_share"},
            {"op": "lead", "field": "station", "as": "runner_up"}
          ],
          "groupby": ["market"],
          "sort": [
            {"field": "share", "order": "descending"}
          ]
        },
        {"filter": "datum.position == 1"},
        {
          "calculate": "round((datum.share - datum.runner_up_share) * 10) / 10",
          "as": "lead_points"
        },
        {
          "calculate": "datum.market + '\\n+' + datum.lead_points + ' pts lead'",
          "as": "map_label"
        },
        {
          "calculate": "datum.market == 'Perth' ? datum.longitude - 8.5 : datum.market == 'Sydney' || datum.market == 'Brisbane' ? datum.longitude + 6.5 : datum.longitude",
          "as": "label_lon"
        },
        {
          "calculate": "datum.market == 'Adelaide' || datum.market == 'Melbourne' ? datum.latitude - 4.4 : datum.latitude",
          "as": "label_lat"
        }
      ],
      "layer": [
        {
          "mark": {"type": "circle", "opacity": 0.9, "cursor": "pointer"},
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "size": {
              "field": "lead_points",
              "type": "quantitative",
              "title": "Lead over No. 2 (points)",
              "scale": {"domain": [0, 6], "range": [0, 3600]},
              "legend": {
                "values": [1, 3, 5],
                "orient": "bottom",
                "direction": "horizontal",
                "symbolFillColor": "#C9D3DA",
                "symbolStrokeColor": "#5C7182"
              }
            },
            "color": {
              "field": "program_format",
              "type": "nominal",
              "title": "Leader's program type",
              "scale": {
                "domain": [
                  "Commercial music",
                  "ABC music",
                  "Commercial talk & news",
                  "ABC talk & news",
                  "Sport"
                ],
                "range": ["#E47B5C", "#F2B8A0", "#2F5D8A", "#7FA3C7", "#E2B33C"]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "symbolSize": 200,
                "values": ["Commercial music", "Commercial talk & news"]
              }
            },
            "stroke": {
              "condition": {"test": "datum.market == SelectedMarket", "value": "#132D43"},
              "value": "#FFFFFF"
            },
            "strokeWidth": {
              "condition": {"test": "datum.market == SelectedMarket", "value": 4},
              "value": 1.5
            },
            "tooltip": [
              {"field": "market", "title": "City"},
              {"field": "station", "title": "No. 1 station"},
              {"field": "program_format", "title": "Program type"},
              {"field": "share", "type": "quantitative", "title": "No. 1 share (%)"},
              {"field": "runner_up", "title": "No. 2 station"},
              {
                "field": "runner_up_share",
                "type": "quantitative",
                "title": "No. 2 share (%)"
              },
              {"field": "lead_points", "type": "quantitative", "title": "Lead (points)"}
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 14,
            "fontWeight": "bold",
            "lineBreak": "\n",
            "lineHeight": 17,
            "color": "#1F3545"
          },
          "encoding": {
            "longitude": {"field": "label_lon", "type": "quantitative"},
            "latitude": {"field": "label_lat", "type": "quantitative"},
            "text": {"field": "map_label"},
            "opacity": {
              "condition": {"test": "datum.market == SelectedMarket", "value": 1},
              "value": 0.75
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
