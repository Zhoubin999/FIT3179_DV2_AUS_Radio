{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/metro_station_share_2026.csv",
    "format": {
      "type": "csv",
      "parse": {"survey": "number", "share": "number"}
    }
  },
  "params": [
    {"name": "SelectedMarket", "value": "Melbourne"}
  ],
  "transform": [
    {"filter": "datum.survey == 3 || datum.survey == 5"},
    {"calculate": "datum.survey == 5 ? datum.share : 0", "as": "share_s5"},
    {"calculate": "datum.survey == 3 ? datum.share : 0", "as": "share_s3"},
    {
      "aggregate": [
        {"op": "sum", "field": "share_s5", "as": "format_share"},
        {"op": "sum", "field": "share_s3", "as": "format_share_s3"},
        {"op": "distinct", "field": "station", "as": "stations"}
      ],
      "groupby": ["market", "program_format"]
    },
    {
      "calculate": "round((datum.format_share - datum.format_share_s3) * 10) / 10",
      "as": "change"
    },
    {
      "calculate": "(datum.change > 0 ? '+' : '') + datum.change + ' points since Survey 3'",
      "as": "change_note"
    },
    {
      "calculate": "indexof(['Commercial music', 'ABC music', 'Commercial talk & news', 'ABC talk & news', 'Sport'], datum.program_format)",
      "as": "format_order"
    },
    {
      "stack": "format_share",
      "groupby": ["market"],
      "sort": [
        {"field": "format_order"}
      ],
      "as": ["bar_start", "bar_end"]
    },
    {"calculate": "(datum.bar_start + datum.bar_end) / 2", "as": "bar_middle"}
  ],
  "encoding": {
    "y": {
      "field": "market",
      "type": "nominal",
      "title": null,
      "sort": ["Sydney", "Melbourne", "Brisbane", "Adelaide", "Perth"],
      "axis": {"labelFontSize": 15, "labelFontWeight": "bold", "labelPadding": 8}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {"band": 0.72},
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "bar_start",
          "type": "quantitative",
          "title": "Share of all radio listening time in Survey 5 (%)",
          "scale": {"domain": [0, 100]}
        },
        "x2": {"field": "bar_end"},
        "color": {
          "field": "program_format",
          "type": "nominal",
          "title": "Program type",
          "scale": {
            "domain": [
              "Commercial music",
              "ABC music",
              "Commercial talk & news",
              "ABC talk & news",
              "Sport"
            ],
            "range": ["#E47B5C", "#F2B8A0", "#2F5D8A", "#7FA3C7", "#E2B33C"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "symbolSize": 160
          }
        },
        "opacity": {
          "condition": {"test": "datum.market == SelectedMarket", "value": 1},
          "value": 0.35
        },
        "tooltip": [
          {"field": "market", "title": "City"},
          {"field": "program_format", "title": "Program type"},
          {
            "field": "format_share",
            "type": "quantitative",
            "title": "Share in Survey 5 (%)",
            "format": ".1f"
          },
          {"field": "change_note", "title": "Change"},
          {"field": "stations", "title": "Number of stations"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.format_share >= 4"}
      ],
      "mark": {"type": "text", "fontSize": 13, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "bar_middle", "type": "quantitative"},
        "text": {"field": "format_share", "type": "quantitative", "format": ".0f"},
        "color": {
          "condition": [
            {"test": "datum.market != SelectedMarket", "value": "#3E5263"},
            {
              "test": "datum.program_format == 'ABC music' || datum.program_format == 'Sport'",
              "value": "#3A2A20"
            }
          ],
          "value": "#FFFFFF"
        }
      }
    }
  ]
}
