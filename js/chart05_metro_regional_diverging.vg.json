{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/c05_audio_gap_2025.csv",
    "format": {
      "type": "csv",
      "parse": {"metro_pct": "number", "regional_pct": "number", "gap_pp": "number"}
    }
  },
  "transform": [
    {
      "calculate": "(datum.gap_pp > 0 ? '+' : '') + datum.gap_pp + ' points ' + (datum.gap_pp > 0 ? 'regional' : 'city')",
      "as": "gap_label"
    },
    {"calculate": "max(datum.metro_pct, datum.regional_pct)", "as": "right_end"}
  ],
  "encoding": {
    "y": {
      "field": "audio_type",
      "type": "nominal",
      "title": null,
      "sort": [
        "FM radio",
        "DAB+ radio",
        "Internet/app radio",
        "Music streaming",
        "Podcasts"
      ],
      "axis": {"labelFontSize": 14, "labelPadding": 8}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 5, "strokeCap": "round", "color": "#D2DCE2"},
      "encoding": {
        "x": {
          "field": "metro_pct",
          "type": "quantitative",
          "title": "Adults who used it in the past week (%)",
          "scale": {"domain": [0, 100]},
          "axis": {"values": [0, 20, 40, 60, 80, 100]}
        },
        "x2": {"field": "regional_pct"}
      }
    },
    {
      "transform": [
        {"fold": ["metro_pct", "regional_pct"], "as": ["area_key", "pct"]},
        {
          "calculate": "datum.area_key == 'metro_pct' ? 'Capital cities' : 'Regional areas'",
          "as": "area"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 230,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "pct", "type": "quantitative"},
        "color": {
          "field": "area",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Capital cities", "Regional areas"],
            "range": ["#2F5D8A", "#E47B5C"]
          },
          "legend": {"orient": "top", "symbolSize": 200}
        },
        "tooltip": [
          {"field": "audio_type", "title": "Audio type"},
          {"field": "area", "title": "Area"},
          {"field": "pct", "type": "quantitative", "title": "Used in past week (%)"},
          {"field": "gap_label", "title": "Difference"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 16,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "right_end", "type": "quantitative"},
        "text": {"field": "gap_label"},
        "color": {
          "condition": {"test": "datum.gap_pp > 0", "value": "#C2573A"},
          "value": "#2F5D8A"
        }
      }
    }
  ]
}
