{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chapter 3 - choropleth map with linked paired bars. Radio infrastructure by state: sites per 100,000 people, % of FM transmitters that are relays, or % of sites that are DAB+ (ACMA records + ABS population). The paired bars show the two counts behind the chosen ratio as each state's share of Australia (grey = the base, navy = the radio count), on one linear axis. Interaction: the dropdown changes both views; hovering a state or its bars highlights it in both. View sizes are set in main.js.",
  "params": [
    {
      "description": "Dropdown that chooses which measure colours the map and sorts the bars.",
      "name": "Measure_selection",
      "value": "per100k",
      "bind": {
        "input": "select",
        "options": ["per100k", "retrans", "dab"],
        "labels": [
          "Radio transmitter sites per 100,000 people",
          "Share of FM transmitters that relay another station (%)",
          "Share of radio sites that broadcast DAB+ (%)"
        ],
        "name": "Colour the map by: "
      }
    },
    {
      "description": "One hover selection shared by the map and the paired bars (views lists both).",
      "name": "State_pick",
      "select": {
        "type": "point",
        "fields": ["state"],
        "on": "pointerover",
        "clear": "pointerout"
      },
      "views": ["state_shapes", "state_bars"]
    }
  ],
  "hconcat": [
    {
      "description": "Left view: the choropleth map.",
      "width": 700,
      "height": 500,
      "projection": {"type": "mercator", "center": [134, -28.5]},
      "layer": [
        {
          "description": "State shapes: join each state to its figures (lookup) and colour by the chosen measure.",
          "name": "state_shapes",
          "data": {
            "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
            "format": {"type": "topojson", "feature": "collection"}
          },
          "transform": [
            {
              "calculate": "datum.properties.STATE == '1' ? 'ACT' : datum.properties.STATE == '3' ? 'NSW' : datum.properties.STATE == '4' ? 'NT' : datum.properties.STATE == '5' ? 'QLD' : datum.properties.STATE == '6' ? 'SA' : datum.properties.STATE == '7' ? 'TAS' : datum.properties.STATE == '8' ? 'VIC' : datum.properties.STATE == '9' ? 'WA' : 'Other'",
              "as": "state"
            },
            {
              "lookup": "state",
              "from": {
                "data": {"url": "data/australian_radio_data.csv"},
                "key": "state",
                "fields": [
                  "state_name",
                  "population",
                  "all_radio_sites",
                  "dab_sites",
                  "radio_sites_per_100k",
                  "fm_records",
                  "fm_retransmission_records",
                  "fm_retransmission_pct",
                  "dab_share_of_sites_pct"
                ]
              }
            },
            {
              "calculate": "Measure_selection == 'per100k' ? toNumber(datum.radio_sites_per_100k) : Measure_selection == 'retrans' ? toNumber(datum.fm_retransmission_pct) : toNumber(datum.dab_share_of_sites_pct)",
              "as": "shown_value"
            }
          ],
          "mark": {"type": "geoshape"},
          "encoding": {
            "color": {
              "field": "shown_value",
              "type": "quantitative",
              "title": "Darker = higher value of the chosen measure",
              "scale": {"type": "sqrt", "range": ["#EEF3F9", "#1F4E79"], "zero": true},
              "legend": {
                "orient": "bottom-left",
                "direction": "horizontal",
                "gradientLength": 200,
                "titleLimit": 340
              }
            },
            "stroke": {
              "condition": {"param": "State_pick", "empty": false, "value": "#1F3545"},
              "value": "#FFFFFF"
            },
            "strokeWidth": {
              "condition": {"param": "State_pick", "empty": false, "value": 2.5},
              "value": 1
            },
            "tooltip": [
              {"field": "state_name", "title": "State / territory"},
              {
                "field": "population",
                "type": "quantitative",
                "title": "Population (Mar 2026)",
                "format": ","
              },
              {
                "field": "all_radio_sites",
                "type": "quantitative",
                "title": "Radio transmitter sites"
              },
              {
                "field": "radio_sites_per_100k",
                "type": "quantitative",
                "title": "Sites per 100,000 people"
              },
              {
                "field": "fm_retransmission_records",
                "type": "quantitative",
                "title": "FM relay transmitters"
              },
              {
                "field": "fm_records",
                "type": "quantitative",
                "title": "All FM transmitters"
              },
              {"field": "dab_sites", "type": "quantitative", "title": "DAB+ sites"}
            ]
          }
        },
        {
          "description": "State labels with the value of the chosen measure.",
          "data": {
            "url": "data/australian_radio_data.csv",
            "format": {
              "type": "csv",
              "parse": {"label_lon": "number", "label_lat": "number"}
            }
          },
          "transform": [
            {"filter": "datum.dataset == 'State infrastructure'"},
            {
              "calculate": "Measure_selection == 'per100k' ? toNumber(datum.radio_sites_per_100k) : Measure_selection == 'retrans' ? toNumber(datum.fm_retransmission_pct) : toNumber(datum.dab_share_of_sites_pct)",
              "as": "shown_value"
            },
            {
              "calculate": "datum.state + ': ' + format(datum.shown_value, '.1f') + (Measure_selection == 'per100k' ? '' : '%')",
              "as": "state_label"
            },
            {
              "joinaggregate": [
                {"op": "max", "field": "shown_value", "as": "max_value"}
              ]
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 15,
            "fontWeight": "bold",
            "align": "center"
          },
          "encoding": {
            "longitude": {"field": "label_lon", "type": "quantitative"},
            "latitude": {"field": "label_lat", "type": "quantitative"},
            "text": {"field": "state_label"},
            "color": {
              "condition": {
                "test": "datum.shown_value > datum.max_value * 0.45",
                "value": "#FFFFFF"
              },
              "value": "#17374A"
            }
          }
        }
      ],
      "title": {
        "text": {
          "expr": "Measure_selection == 'per100k' ? 'Showing: radio transmitter sites per 100,000 people (number)' : Measure_selection == 'retrans' ? 'Showing: share of FM transmitters that relay another station (%)' : 'Showing: share of radio sites that broadcast DAB+ (%)'"
        },
        "anchor": "start",
        "fontSize": 15,
        "offset": 10,
        "subtitle": "Hover a state or its bars to highlight it in both views",
        "subtitleFontSize": 13,
        "subtitleColor": "#5C7182"
      }
    },
    {
      "description": "Right view: each state's share of Australia's base count (grey) and radio count (navy), sorted by the chosen measure. Navy longer than grey = above the Australian rate.",
      "width": 300,
      "height": 480,
      "title": {
        "text": "Each state's share of Australia",
        "subtitle": {
          "expr": "'Grey: share of ' + (Measure_selection == 'per100k' ? 'people' : Measure_selection == 'retrans' ? 'all FM transmitters' : 'all radio sites') + '   Navy: share of ' + (Measure_selection == 'per100k' ? 'radio sites' : Measure_selection == 'retrans' ? 'FM relays' : 'DAB+ sites')"
        },
        "anchor": "start",
        "fontSize": 15,
        "offset": 10,
        "subtitleFontSize": 13,
        "subtitleColor": "#5C7182"
      },
      "data": {"url": "data/australian_radio_data.csv"},
      "transform": [
        {
          "description": "One row per state with the two counts behind the chosen measure.",
          "filter": "datum.dataset == 'State infrastructure'"
        },
        {
          "calculate": "Measure_selection == 'per100k' ? toNumber(datum.population) : Measure_selection == 'retrans' ? toNumber(datum.fm_records) : toNumber(datum.all_radio_sites)",
          "as": "base_count"
        },
        {
          "calculate": "Measure_selection == 'per100k' ? toNumber(datum.all_radio_sites) : Measure_selection == 'retrans' ? toNumber(datum.fm_retransmission_records) : toNumber(datum.dab_sites)",
          "as": "radio_count"
        },
        {
          "calculate": "Measure_selection == 'per100k' ? toNumber(datum.radio_sites_per_100k) : Measure_selection == 'retrans' ? toNumber(datum.fm_retransmission_pct) : toNumber(datum.dab_share_of_sites_pct)",
          "as": "shown_value"
        },
        {
          "description": "Turn both counts into shares of the Australian total.",
          "joinaggregate": [
            {"op": "sum", "field": "base_count", "as": "base_total"},
            {"op": "sum", "field": "radio_count", "as": "radio_total"}
          ]
        },
        {"calculate": "100 * datum.base_count / datum.base_total", "as": "Base share"},
        {"calculate": "100 * datum.radio_count / datum.radio_total", "as": "Radio share"},
        {
          "description": "Two rows per state: one per bar.",
          "fold": ["Base share", "Radio share"],
          "as": ["bar", "share"]
        },
        {
          "calculate": "datum.bar == 'Base share' ? 'Share of ' + (Measure_selection == 'per100k' ? 'people' : Measure_selection == 'retrans' ? 'all FM transmitters' : 'all radio sites') : 'Share of ' + (Measure_selection == 'per100k' ? 'radio sites' : Measure_selection == 'retrans' ? 'FM relays' : 'DAB+ sites')",
          "as": "bar_name"
        },
        {"calculate": "format(datum.share, '.1f') + '%'", "as": "share_label"}
      ],
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {"field": "shown_value", "op": "max", "order": "descending"},
          "axis": {
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "domain": false,
            "ticks": false,
            "labelPadding": 6
          }
        },
        "yOffset": {
          "field": "bar",
          "type": "nominal",
          "sort": ["Base share", "Radio share"]
        },
        "x": {
          "field": "share",
          "type": "quantitative",
          "scale": {"nice": true},
          "axis": {
            "title": "Share of Australia (%)",
            "grid": true,
            "tickCount": 5,
            "titleFontSize": 13,
            "titleColor": "#4D6273"
          }
        }
      },
      "layer": [
        {
          "description": "The paired bars; hovering one highlights its state on the map too.",
          "name": "state_bars",
          "mark": {"type": "bar", "cornerRadiusEnd": 3, "cursor": "pointer"},
          "encoding": {
            "color": {
              "field": "bar",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": ["Base share", "Radio share"],
                "range": ["#B9C4CD", "#2F5D8A"]
              }
            },
            "opacity": {
              "condition": {"param": "State_pick", "empty": true, "value": 1},
              "value": 0.35
            },
            "tooltip": [
              {"field": "state_name", "title": "State / territory"},
              {"field": "bar_name", "title": "Bar"},
              {"field": "share_label", "title": "Share of Australia"}
            ]
          }
        },
        {
          "description": "Share at the end of each bar.",
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "fontSize": 13,
            "color": "#3E5263"
          },
          "encoding": {
            "text": {"field": "share_label"}
          }
        },
        {
          "description": "Invisible point just past the longest bar, so its value label is never cut off.",
          "transform": [
            {
              "aggregate": [
                {"op": "max", "field": "share", "as": "max_share"}
              ]
            },
            {"calculate": "datum.max_share * 1.18", "as": "x_room"}
          ],
          "mark": {"type": "point", "opacity": 0},
          "encoding": {
            "x": {"field": "x_room", "type": "quantitative"},
            "y": {"value": 0},
            "yOffset": null
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {"color": "shared"}
  },
  "config": {
    "view": {"stroke": null},
    "concat": {"spacing": 24}
  },
  "padding": {"left": 0, "right": 0, "top": 6, "bottom": 6}
}
